docs {
  # AI governance console — must be auth-gated.
  # Contract: unauthenticated → 401 (never 404).
}

tests {
  test("settings/ai-governance rejects unauthenticated requests with 401", function () {
    expect(res.status).to.equal(401);
  });

  test("settings/ai-governance 401 body carries an error", function () {
    expect(res.body).to.have.property("error");
  });
}
