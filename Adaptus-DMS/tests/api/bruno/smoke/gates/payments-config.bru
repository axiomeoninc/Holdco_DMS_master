meta {
  name: payments-config
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/payments/config
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Accept: application/json
}

docs {
  # Payment provider config state (honest — never exposes the secret key).
  #
  # Unauthenticated: 401 (auth gate first).
  # Authenticated (when an access_token is provided): 200 with data.configured.
  # With Stripe unset, configured must be exactly false — no fabricated URLs.
}

tests {
  test("payments/config rejects unauthenticated requests with 401", function () {
    expect(res.status).to.equal(401);
  });

  test("payments/config 401 body carries an error", function () {
    expect(res.body).to.have.property("error");
  });

  test("payments/config is honest about provider state when authed", function () {
    const hasToken = String(bru.getEnvVar("access_token") || "").trim().length > 0;
    if (!hasToken) {
      return;
    }
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("data");
    expect(res.body.data).to.have.property("configured");
    expect(res.body.data.configured).to.equal(false);
  });
}
